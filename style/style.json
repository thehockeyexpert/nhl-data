 "layout": {
  "name": "studio_edition",
  "margin_px": 80,
  "header": {
   "label_y": 104,
   "label_size": 26,
   "rule_y": 132
  },
  "footer": {
   "rule_y": 1248,
   "text_y": 1290,
   "text_size": 22
  },
  "hairline": {
   "width": 2,
   "opacity_light": 0.14,
   "opacity_dark": 0.16
  },
  "rounded_corners": false,
  "reference": "studio_reference.html"
 },
 "story": {
  "slides": [
   "hook",
   "reveal",
   "comparison",
   "trend",
   "turning_point",
   "conclusion",
   "statement",
   "question",
   "guess",
   "leaderboard"
  ],
  "default_mode": "mixed",
  "mixed": {
   "hook": "dark",
   "reveal": "dark",
   "comparison": "light",
   "trend": "light",
   "turning_point": "light",
   "conclusion": "dark",
   "statement": "dark",
   "question": "dark",
   "guess": "dark",
   "leaderboard": "light"
  },
  "comparison_panel": {
   "light": "#E4EAF0",
   "dark": "#202A35"
  },
  "reference": "story_reference.html",
  "frame": {
   "header": false,
   "slide_counter": false,
   "hairlines": false,
   "source_line": false,
   "handle": {
    "x_right": 1000,
    "y": 1290,
    "size": 24
   },
   "data_credit": "caption or comments: 'Data: NHL.', or 'Data, logos and headshots: NHL.' when any NHL image is used"
  },
  "comparison_panel_top": 0,
  "clean_text_rule": "Every piece of text must add something new; never repeat a fact already on the slide."
 },
 "nhl_images": {
  "allowed": true,
  "decided": "2026-11-11",
  "logo_url": "https://assets.nhle.com/logos/nhl/svg/{TEAM}_{light|dark}.svg",
  "headshot_source": "headshot field of https://api-web.nhle.com/v1/player/{id}/landing",
  "never": [
   "automatic downloads from Getty, Imagn, team sites or image searches",
   "AI-generated pictures of real players",
   "recolouring, stretching or effects on logos"
  ],
  "local_folder": "assets/nhl/ (git-ignored, never committed)",
  "limits": {
   "headshots_per_carousel": 1,
   "logos_per_slide": 1,
   "logos_per_comparison_slide": 2
  },
  "headshot": {
   "slides": [
    "hook",
    "reveal"
   ],
   "anchor": "bottom-right",
   "max_height_pct": 60,
   "must_not_cover": [
    "headline",
    "big_number",
    "handle"
   ]
  },
  "logo": {
   "height_px": [
    80,
    120
   ],
   "clear_space": "0.25 x logo height",
   "variant": "light on light slides, dark on dark slides"
  },
  "yaml_field": "optional per-slide image: {type: headshot|logo|photo, player_id or team or file, position, credit}",
  "photo_sources": [
   "Wikimedia Commons, free licence only (CC BY, CC BY-SA, public domain), photographer and licence credited in caption",
   "a file Anthony saves in assets/nhl/photos/ with a credit: field"
  ]
 }
}