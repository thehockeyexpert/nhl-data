      "bar_track": "#E1E7EC",
      "grid": "#DCE3E9",
      "default_accent": "#FF5A36"
    },
    "fresh_ice_dark": {
      "background": "#0E1A26",
      "ink": "#F4F7F9",
      "muted_text": "#9AA8B6",
      "bar_track": "#1E2D3C",
      "grid": "#22313F",
      "default_accent": "#FF5A36"
    }
  },
  "fonts": {
    "title": "Barlow Condensed Bold",
    "label": "Barlow Condensed Bold, uppercase, letter-spacing 0.1em",
    "body_and_numbers": "Barlow SemiBold/Bold",
    "source": "Google Fonts, free (OFL)"
  },
  "accent_rule": {
    "min_contrast_bars_and_shapes": 3.0,
    "min_contrast_text": 4.5,
    "method": "If the accent's WCAG contrast against the background is below the minimum, mix it toward white (dark background) or black (light background) in 4% steps until it passes. Keep the hue."
  },
